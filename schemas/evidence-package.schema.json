{
  "$defs": {
    "ActionContract": {
      "additionalProperties": false,
      "properties": {
        "api_group": {
          "title": "Api Group",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Namespace"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "resource_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Name"
        },
        "verb": {
          "minLength": 1,
          "title": "Verb",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "api_group",
        "resource",
        "namespace",
        "resource_name"
      ],
      "title": "ActionContract",
      "type": "object"
    },
    "AuthorizationContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "coverage_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Warnings",
          "type": "array"
        },
        "paths": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Paths",
          "type": "array"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "action",
        "allowed",
        "paths",
        "coverage_warnings"
      ],
      "title": "AuthorizationContract",
      "type": "object"
    },
    "BenignInvariantContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "expected": {
          "const": "allowed",
          "title": "Expected",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "name",
        "principal",
        "action",
        "expected"
      ],
      "title": "BenignInvariantContract",
      "type": "object"
    },
    "CandidateProposalContract": {
      "additionalProperties": false,
      "properties": {
        "coverage_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Warnings",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/RemediationProposalContract"
        },
        "proposal_digest": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Proposal Digest",
          "type": "string"
        },
        "remaining_paths": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Remaining Paths",
          "type": "array"
        },
        "tested_action_blocked_under_supported_model": {
          "title": "Tested Action Blocked Under Supported Model",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "proposal",
        "proposal_digest",
        "remaining_paths",
        "tested_action_blocked_under_supported_model",
        "coverage_warnings"
      ],
      "title": "CandidateProposalContract",
      "type": "object"
    },
    "ClaimContract": {
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "minLength": 1,
          "title": "Claim Type",
          "type": "string"
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "derived_under_supported_model",
            "hypothesis",
            "contradicted",
            "unknown"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "support": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Support",
          "type": "array"
        }
      },
      "required": [
        "claim_type",
        "epistemic_status",
        "statement",
        "support",
        "limitations"
      ],
      "title": "ClaimContract",
      "type": "object"
    },
    "EvidenceArtifactContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "sha256",
        "source",
        "byte_length"
      ],
      "title": "EvidenceArtifactContract",
      "type": "object"
    },
    "FindingContract": {
      "additionalProperties": false,
      "properties": {
        "access_artifact_id": {
          "minLength": 1,
          "title": "Access Artifact Id",
          "type": "string"
        },
        "access_event_id": {
          "minLength": 1,
          "title": "Access Event Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationContract"
        },
        "candidate_proposals": {
          "items": {
            "$ref": "#/$defs/CandidateProposalContract"
          },
          "title": "Candidate Proposals",
          "type": "array"
        },
        "change_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Change Artifact Ids",
          "type": "array"
        },
        "change_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Change Event Ids",
          "type": "array"
        },
        "claim_evidence_complete": {
          "title": "Claim Evidence Complete",
          "type": "boolean"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimContract"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "minLength": 1,
          "title": "Finding Type",
          "type": "string"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        },
        "workflow_prechecks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Workflow Prechecks",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "finding_type",
        "environment_id",
        "principal",
        "action",
        "access_event_id",
        "access_artifact_id",
        "change_event_ids",
        "change_artifact_ids",
        "observed_at",
        "claims",
        "authorization",
        "candidate_proposals",
        "workflow_prechecks",
        "claim_evidence_complete"
      ],
      "title": "FindingContract",
      "type": "object"
    },
    "ProposalMutationContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "delete_role_binding",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ProposalTargetContract"
        }
      },
      "required": [
        "action",
        "target"
      ],
      "title": "ProposalMutationContract",
      "type": "object"
    },
    "ProposalTargetContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RoleBinding",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resource_version": {
          "minLength": 1,
          "title": "Resource Version",
          "type": "string"
        },
        "uid": {
          "minLength": 1,
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "namespace",
        "uid",
        "resource_version"
      ],
      "title": "ProposalTargetContract",
      "type": "object"
    },
    "RemediationProposalContract": {
      "additionalProperties": false,
      "properties": {
        "action_class": {
          "const": "delete_role_binding",
          "title": "Action Class",
          "type": "string"
        },
        "benign_invariants": {
          "items": {
            "$ref": "#/$defs/BenignInvariantContract"
          },
          "title": "Benign Invariants",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "execution_status": {
          "enum": [
            "not_executed",
            "approved",
            "executed",
            "rejected"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "model_coverage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Model Coverage",
          "type": "array"
        },
        "mutations": {
          "items": {
            "$ref": "#/$defs/ProposalMutationContract"
          },
          "minItems": 1,
          "title": "Mutations",
          "type": "array"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "security_objective": {
          "$ref": "#/$defs/SecurityObjectiveContract"
        },
        "snapshot_artifact_id": {
          "minLength": 1,
          "title": "Snapshot Artifact Id",
          "type": "string"
        },
        "state_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "title": "State Fingerprint",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ValidationContract"
        }
      },
      "required": [
        "proposal_id",
        "environment_id",
        "snapshot_artifact_id",
        "state_fingerprint",
        "action_class",
        "mutations",
        "security_objective",
        "benign_invariants",
        "model_coverage",
        "validation",
        "execution_status"
      ],
      "title": "RemediationProposalContract",
      "type": "object"
    },
    "SecurityObjectiveContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "expected": {
          "const": "blocked",
          "title": "Expected",
          "type": "string"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "action",
        "expected"
      ],
      "title": "SecurityObjectiveContract",
      "type": "object"
    },
    "ValidationContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "fidelity_notes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fidelity Notes",
          "type": "array"
        },
        "status": {
          "enum": [
            "not_validated",
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fidelity_notes"
      ],
      "title": "ValidationContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifactContract"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/FindingContract"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "package_type": {
      "const": "reprise_incident_evidence",
      "title": "Package Type",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "additionalProperties": true,
      "title": "Source",
      "type": "object"
    }
  },
  "required": [
    "package_type",
    "environment",
    "source",
    "findings",
    "artifacts",
    "limitations"
  ],
  "title": "EvidencePackageContract",
  "type": "object"
}
