{
  "$defs": {
    "ActionContract": {
      "additionalProperties": false,
      "properties": {
        "api_group": {
          "title": "Api Group",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Namespace"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "resource_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Name"
        },
        "verb": {
          "minLength": 1,
          "title": "Verb",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "api_group",
        "resource",
        "namespace",
        "resource_name"
      ],
      "title": "ActionContract",
      "type": "object"
    },
    "BenignInvariantContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "expected": {
          "const": "allowed",
          "title": "Expected",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "name",
        "principal",
        "action",
        "expected"
      ],
      "title": "BenignInvariantContract",
      "type": "object"
    },
    "ProposalMutationContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "delete_role_binding",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ProposalTargetContract"
        }
      },
      "required": [
        "action",
        "target"
      ],
      "title": "ProposalMutationContract",
      "type": "object"
    },
    "ProposalTargetContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RoleBinding",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "resource_version": {
          "minLength": 1,
          "title": "Resource Version",
          "type": "string"
        },
        "uid": {
          "minLength": 1,
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "namespace",
        "uid",
        "resource_version"
      ],
      "title": "ProposalTargetContract",
      "type": "object"
    },
    "SecurityObjectiveContract": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionContract"
        },
        "expected": {
          "const": "blocked",
          "title": "Expected",
          "type": "string"
        },
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "action",
        "expected"
      ],
      "title": "SecurityObjectiveContract",
      "type": "object"
    },
    "ValidationContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "fidelity_notes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fidelity Notes",
          "type": "array"
        },
        "status": {
          "enum": [
            "not_validated",
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fidelity_notes"
      ],
      "title": "ValidationContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_class": {
      "const": "delete_role_binding",
      "title": "Action Class",
      "type": "string"
    },
    "benign_invariants": {
      "items": {
        "$ref": "#/$defs/BenignInvariantContract"
      },
      "title": "Benign Invariants",
      "type": "array"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "not_executed",
        "approved",
        "executed",
        "rejected"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "model_coverage": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Model Coverage",
      "type": "array"
    },
    "mutations": {
      "items": {
        "$ref": "#/$defs/ProposalMutationContract"
      },
      "minItems": 1,
      "title": "Mutations",
      "type": "array"
    },
    "proposal_id": {
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "security_objective": {
      "$ref": "#/$defs/SecurityObjectiveContract"
    },
    "snapshot_artifact_id": {
      "minLength": 1,
      "title": "Snapshot Artifact Id",
      "type": "string"
    },
    "state_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "title": "State Fingerprint",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ValidationContract"
    }
  },
  "required": [
    "proposal_id",
    "environment_id",
    "snapshot_artifact_id",
    "state_fingerprint",
    "action_class",
    "mutations",
    "security_objective",
    "benign_invariants",
    "model_coverage",
    "validation",
    "execution_status"
  ],
  "title": "RemediationProposalContract",
  "type": "object"
}
